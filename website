              >
                Careers &amp; Roles
              </button>
              
              <button 
                onClick={() => navigate('inbox')}
                className={`text-sm font-semibold flex items-center gap-1.5 transition-colors ${currentView === 'inbox' ? 'text-purple-600' : 'text-slate-600 hover:text-slate-900'}`}
              >
                <Inbox className="w-4 h-4" />
                Candidate Portal
              </button>

              <button 
                onClick={() => { navigate('home'); setCompassStep(0); }} 
                className="text-sm font-semibold text-slate-600 hover:text-slate-900 transition-colors"
              >
                Meet Nexy
