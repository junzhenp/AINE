// --- APPLY VIEW (Expanded with upload files and website link fields) ---
function ApplyView({ job, onNavigate, applications, setApplications, activeCandidateEmail, setActiveCandidateEmail }) {
  const [formData, setFormData] = useState({ 
    name: '', 
    email: activeCandidateEmail || '', 
    resumeText: '',
    portfolioUrl: '',
    githubUrl: '',
    fileName: ''
  });
  const [roleType, setRoleType] = useState('Full-time'); 
  const [status, setStatus] = useState('idle'); // idle, screening, complete
  const [screeningPhase, setScreeningPhase] = useState('');

  if (!job) return <div>No job selected.</div>;

  const handleApply = (e) => {
    e.preventDefault();
    if (!formData.name || !formData.email || !formData.resumeText) return;
    
    setStatus('screening');
    runAISimulation();
  };

  const runAISimulation = () => {
    const phases = [
      `Initializing ${roleType} calibration criteria...`,
      "Evaluating resume keywords and text structures...",
      "Analyzing core transferable skills...",
      "Scanning portfolio and external reference links...",
      "Calculating semantic match profile...",
      "Generating final match feedback..."
    ];
    
    let step = 0;
    const interval = setInterval(() => {
      setScreeningPhase(phases[step]);
      step++;
      
      if (step >= phases.length) {
        clearInterval(interval);
        finalizeApplication();
      }
    }, 700);
  };

  const finalizeApplication = () => {
    const resumeLower = formData.resumeText.toLowerCase();
    const selectedKeywords = roleType === 'Internship' ? job.internKeywords : job.keywords;
    const matchedSkills = selectedKeywords.filter(kw => resumeLower.includes(kw));
    
    let baseScore = (matchedSkills.length / selectedKeywords.length) * 100;
    let scoreVariance = Math.floor(Math.random() * 15);
    let finalScore = Math.min(100, Math.max(15, Math.round(baseScore + scoreVariance)));

    let aiSummary = "";
    if (roleType === 'Internship') {
      if (finalScore >= 75) {
        aiSummary = `Excellent Intern match! Shows immense curiosity, motivation, and foundational skills in ${matchedSkills.slice(0, 3).join(', ') || 'relevant fields'}. Strong candidate for learning program.`;
      } else {
        aiSummary = `Moderate Intern match. Demonstrates general interest but needs further training/alignment in basic requirements like ${selectedKeywords.slice(0, 2).join(', ')}.`;
      }
    } else {
      if (finalScore >= 80) {
        aiSummary = `Strong Full-Time match. Candidate's resume shows high relevance to requirements, specifically matching core skills: ${matchedSkills.slice(0, 3).join(', ')}. Recommended for immediate screen.`;
      } else if (finalScore >= 50) {
        aiSummary = `Moderate Full-Time match. Candidate has core foundations but could be missing comprehensive strategic execution skills.`;
      } else {
        aiSummary = `Low Full-Time match. The background lacks key strategic execution indicators required for this role.`;
      }
    }

    const newApp = {
      id: `a${Date.now()}`,
      jobId: job.id,
      name: formData.name,
      email: formData.email.trim().toLowerCase(),
      type: roleType,
      fileName: formData.fileName || 'Uploaded_Resume.pdf',
      portfolioUrl: formData.portfolioUrl || formData.githubUrl || '',
      aiScore: finalScore,
      recruiterScore: finalScore, 
      recruiterFeedback: '',
      aiSummary: aiSummary,
      status: 'AI Calibrated',
      date: new Date().toISOString().split('T')[0]
    };

    setApplications([...applications, newApp]);
    setActiveCandidateEmail(formData.email.trim().toLowerCase());
    setStatus('complete');
  };

  const triggerFileMock = () => {
    setFormData(prev => ({ ...prev, fileName: 'Resume_Nexus_Submission.pdf' }));
  };

  return (
    <div className="max-w-3xl mx-auto space-y-8 py-4">
      <div>
        <button 
          onClick={() => onNavigate('jobs')}
          className="text-sm font-semibold text-slate-500 hover:text-slate-900 mb-6 flex items-center transition-colors"
        >
          ← Back to Roles
        </button>
        <h1 className="text-3xl font-extrabold text-slate-900 mb-2">Apply for {job.title}</h1>
        <p className="text-slate-600">{job.location} • {job.department}</p>
      </div>

      <div className="bg-white rounded-2xl p-6 md:p-8 border border-purple-100 shadow-sm relative overflow-hidden">
        
        {/* Screening Overlay */}
        {status === 'screening' && (
          <div className="absolute inset-0 bg-white/95 backdrop-blur-sm z-10 flex flex-col items-center justify-center space-y-6">
            <div className="relative">
              <div className="w-24 h-24 rounded-full border-4 border-slate-200"></div>
              <div className="w-24 h-24 rounded-full border-4 border-purple-600 border-t-transparent animate-spin absolute top-0 left-0"></div>
              <Bot className="h-10 w-10 text-purple-600 absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 animate-bounce" />
            </div>
            <div className="text-center space-y-2">
              <h3 className="text-xl font-bold text-slate-900">Custom Track Calibration</h3>
              <p className="text-purple-600 font-bold text-sm">Calibrating for: {roleType} Track</p>
              <p className="text-slate-600 min-h-[1.5rem] transition-all text-sm px-4">{screeningPhase}</p>
            </div>
            <div className="w-64 h-2 bg-slate-200 rounded-full overflow-hidden">
              <div className="h-full bg-purple-600 animate-[pulse_2s_ease-in-out_infinite] w-full"></div>
            </div>
          </div>
        )}

        <form onSubmit={handleApply} className="space-y-6">
          {/* Track Difficulty Selector */}
          <div className="bg-purple-50/50 p-4 rounded-xl border border-purple-100 space-y-3">
            <label className="text-sm font-bold text-purple-900 block">Choose Your Desired Track</label>
            <div className="grid grid-cols-2 gap-4">
              <button
                type="button"
                onClick={() => setRoleType('Full-time')}
                className={`py-3 px-4 rounded-xl border-2 font-bold flex flex-col items-center justify-center transition-all ${roleType === 'Full-time' ? 'border-blue-600 bg-purple-100/30 text-purple-900' : 'border-slate-200 bg-white text-slate-600 hover:border-slate-300'}`}
              >
                <Briefcase className="h-5 w-5 mb-1" />
                <span className="text-sm">Full-time Track</span>
                <span className="text-[10px] text-slate-500 font-normal">Assesses execution experience</span>
              </button>
              <button
                type="button"
                onClick={() => setRoleType('Internship')}
