                        type="email" 
                        required
                        value={candidateLoginInput}
                        onChange={(e) => setCandidateLoginInput(e.target.value)}
                        placeholder="Candidate Email"
                        className="w-40 xl:w-48 pl-2 pr-2 py-1 rounded-md border border-purple-200 text-xs focus:ring-1 focus:ring-purple-600 focus:border-purple-600 outline-none bg-white"
