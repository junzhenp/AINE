  // Personal Candidate Portal Login state
  const [activeCandidateEmail, setActiveCandidateEmail] = useState('');
  const [candidateLoginInput, setCandidateLoginInput] = useState('');
  const [loginFeedback, setLoginFeedback] = useState('');

  // Navigation Helper
  const navigate = (view, job = null) => {
    setCurrentView(view);
    if (job) setSelectedJob(job);
    window.scrollTo(0, 0);
  };

  // Recruiter Portal State Updates
  const handleRecruiterUpdate = (id, field, value) => {
    setApplications(prev => prev.map(app => {
      if (app.id === id) {
        return { ...app, [field]: value };
      }
      return app;
    }));
  };

  // Mascot click handler to generate fresh, positive, and safe quotes
  const handleMascotClick = () => {
    const randomIndex = Math.floor(Math.random() * MASCOT_QUOTES.length);
    setMascotBubble(MASCOT_QUOTES[randomIndex]);
  };

  // Candidate Quick Account Login
  const handleCandidateLogin = (e) => {
    e.preventDefault();
    const cleanEmail = candidateLoginInput.trim().toLowerCase();
    if (!cleanEmail) return;

    // Check if candidate exists in our state
    const matches = applications.filter(app => app.email.toLowerCase() === cleanEmail);
    if (matches.length > 0) {
      setActiveCandidateEmail(cleanEmail);
      setLoginFeedback('');
      navigate('inbox');
    } else {
      setLoginFeedback("Email not registered yet. Apply to any job to create your tracking dashboard!");
      // Briefly show alert style notice
      setTimeout(() => setLoginFeedback(''), 5000);
    }
  };

  const handleLogoutCandidate = () => {
    setActiveCandidateEmail('');
    setCandidateLoginInput('');
    setLoginFeedback('');
  };

  return (
    <div className="min-h-screen bg-slate-50 font-sans text-slate-900 flex flex-col">
