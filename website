          A secure space to review dynamic status updates, skills calibration feedback, and adjusted scores from our recruiting team.
        </p>
      </div>

      {!activeCandidateEmail ? (
        /* Login Required UI */
        <div className="bg-white p-8 rounded-2xl border border-purple-100 shadow-sm max-w-lg mx-auto text-center space-y-6">
          <div className="mx-auto w-12 h-12 rounded-full bg-purple-50 flex items-center justify-center text-purple-600">
            <Lock className="w-6 h-6" />
          </div>
          <div className="space-y-2">
            <h3 className="text-lg font-bold">Sign In to Track Applications</h3>
            <p className="text-xs text-slate-500">
              Please enter the email address you used in your application to track your review progress.
            </p>
          </div>
          <form onSubmit={onLogin} className="space-y-4 text-left">
            <div>
              <label className="block text-xs font-bold text-slate-600 mb-1">Registered Email Address</label>
              <input 
                type="email" 
                required
                value={candidateLoginInput}
                onChange={(e) => setCandidateLoginInput(e.target.value)}
                placeholder="e.g. sophia@example.com"
                className="w-full border border-slate-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-purple-600 focus:border-purple-600 outline-none text-sm py-2.5"
              />
            </div>
            {loginFeedback && (
              <div className="text-xs text-amber-600 bg-amber-50 p-2.5 rounded border border-amber-100 flex items-center gap-1">
                <AlertCircle className="w-4 h-4" /> {loginFeedback}
              </div>
            )}
            <button 
              type="submit"
              className="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-2.5 rounded-lg text-sm transition-colors"
            >
              Access Portal
            </button>
          </form>
          <div className="bg-slate-50 p-3 rounded-lg border border-slate-100 text-left">
            <p className="text-[11px] text-slate-500">
              💡 For testing: You can type <strong className="text-purple-700">sophia@example.com</strong> to see a simulated pre-existing internship applicant!
            </p>
          </div>
        </div>
      ) : (
        /* Authenticated Session UI */
        <div className="space-y-8">
          <div className="bg-purple-900 text-white p-6 rounded-2xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div className="space-y-1">
              <span className="text-xs text-purple-300 uppercase tracking-widest font-bold">Active Account Portal</span>
              <h3 className="text-xl font-bold">{activeCandidateEmail}</h3>
            </div>
            <div className="flex gap-2">
              <button 
                onClick={() => onNavigate('jobs')}
                className="bg-white/10 hover:bg-white/20 text-white text-xs font-semibold px-4 py-2 rounded-lg transition-all"
              >
                Apply for New Role
              </button>
              <button 
                onClick={onLogout}
                className="bg-purple-800 hover:bg-purple-700 text-purple-200 text-xs font-semibold px-4 py-2 rounded-lg transition-all"
              >
                Sign Out
              </button>
            </div>
          </div>

          <div className="space-y-6">
            <h3 className="text-lg font-bold text-slate-800">Your Active Applications ({candidateApps.length})</h3>
            
            {candidateApps.map((app) => {
              // Stepper index based on pipeline status
              const statuses = ["AI Calibrated", "Shortlisted", "Interview Scheduled"];
              let activeStep = statuses.indexOf(app.status);
              if (activeStep === -1) activeStep = 0; // fallback

              return (
                <div key={app.id} className="bg-white border border-purple-100 rounded-2xl p-6 shadow-sm space-y-8 animate-[fade-in_0.3s_ease-out]">
                  
                  {/* Top application meta & scores */}
                  <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-slate-100 pb-4">
                    <div>
                      <span className="text-[10px] font-extrabold uppercase bg-purple-50 text-purple-700 px-2 py-0.5 rounded border border-purple-100">
                        {app.type} Track
                      </span>
                      <h4 className="text-xl font-bold text-slate-900 mt-1">{getJobTitle(app.jobId)}</h4>
                      <p className="text-xs text-slate-400">Application Reference ID: {app.id} • Dated {app.date}</p>
                    </div>
                    
                    {/* Visual Score display */}
                    <div className="flex items-center gap-3 bg-purple-50/50 p-3 rounded-xl border border-purple-100">
                      <div className="text-center px-1">
                        <span className="text-[9px] font-bold text-slate-400 uppercase block">AI Analysis</span>
                        <span className="text-xs font-bold text-slate-500">{app.aiScore}%</span>
                      </div>
                      <div className="w-px h-8 bg-purple-200"></div>
                      <div className="text-center px-1">
                        <span className="text-[9px] font-bold text-purple-700 uppercase block">Hiring Manager</span>
                        <span className="text-base font-extrabold text-purple-900">{app.recruiterScore}%</span>
                      </div>
                    </div>
                  </div>

                  {/* VISUAL STATUS TRACKER STEPPER */}
                  <div className="space-y-4">
                    <h5 className="text-xs font-bold text-slate-400 uppercase tracking-widest">Application Progress Tracker</h5>
                    <div className="grid grid-cols-4 items-center">
                      
                      {/* Step 1 */}
                      <div className="flex flex-col items-center relative">
                        <div className="w-8 h-8 rounded-full bg-purple-600 text-white flex items-center justify-center font-bold text-xs">
                          <Check className="w-4 h-4" />
                        </div>
                        <span className="text-[11px] font-bold text-slate-800 mt-2 text-center">Applied</span>
                        <div className="absolute top-4 left-[calc(50%+16px)] right-0 h-1 bg-purple-600 w-full -z-10 hidden sm:block"></div>
                      </div>

                      {/* Step 2 */}
                      <div className="flex flex-col items-center relative">
                        <div className="w-8 h-8 rounded-full bg-purple-600 text-white flex items-center justify-center font-bold text-xs">
                          <Check className="w-4 h-4" />
                        </div>
                        <span className="text-[11px] font-bold text-slate-800 mt-2 text-center">AI Calibrated</span>
                        <div className={`absolute top-4 left-[calc(50%+16px)] right-0 h-1 w-full -z-10 hidden sm:block ${activeStep >= 1 ? 'bg-purple-600' : 'bg-slate-200'}`}></div>
                      </div>

                      {/* Step 3 */}
                      <div className="flex flex-col items-center relative">
                        <div className={`w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs ${activeStep >= 1 ? 'bg-purple-600 text-white' : 'bg-slate-200 text-slate-400'}`}>
                          {activeStep >= 1 ? <Check className="w-4 h-4" /> : "3"}
                        </div>
                        <span className={`text-[11px] font-bold mt-2 text-center ${activeStep >= 1 ? 'text-slate-800' : 'text-slate-400'}`}>HR Reviewed</span>
                        <div className={`absolute top-4 left-[calc(50%+16px)] right-0 h-1 w-full -z-10 hidden sm:block ${activeStep >= 2 ? 'bg-purple-600' : 'bg-slate-200'}`}></div>
                      </div>

                      {/* Step 4 */}
                      <div className="flex flex-col items-center relative">
                        <div className={`w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs ${activeStep >= 2 ? 'bg-purple-600 text-white' : 'bg-slate-200 text-slate-400'}`}>
                          {activeStep >= 2 ? <Check className="w-4 h-4" /> : "4"}
                        </div>
                        <span className={`text-[11px] font-bold mt-2 text-center ${activeStep >= 2 ? 'text-slate-800' : 'text-slate-400'}`}>Interview Phase</span>
                      </div>

                    </div>
                  </div>

                  {/* Feedback Blocks */}
                  <div className="grid md:grid-cols-2 gap-6 pt-4 border-t border-slate-100">
                    <div className="space-y-2 bg-slate-50 p-4 rounded-xl border border-slate-100 relative">
                      <BrainCircuit className="absolute top-4 right-4 h-5 w-5 text-purple-200" />
                      <h5 className="text-xs font-bold text-slate-500 uppercase tracking-wider">AI Screen Summary</h5>
                      <p className="text-xs text-slate-600 leading-relaxed">{app.aiSummary}</p>
                    </div>

                    <div className="space-y-2 bg-purple-50/40 p-4 rounded-xl border border-purple-100/50 relative">
                      <MessageSquare className="absolute top-4 right-4 h-5 w-5 text-purple-400 animate-pulse" />
                      <h5 className="text-xs font-bold text-purple-700 uppercase tracking-wider">Recruiter Feedback &amp; Mentorship Notes</h5>
                      {app.recruiterFeedback ? (
                        <p className="text-xs text-slate-700 leading-relaxed font-semibold">
                          "{app.recruiterFeedback}"
                        </p>
                      ) : (
                        <div className="space-y-2">
                          <p className="text-xs text-slate-500 italic leading-relaxed">
                            "We are currently reviewing your calibrated criteria against our upcoming interview slots. We will publish your mentoring notes right here shortly!"
                          </p>
                          <div className="flex items-center space-x-1.5 text-[10px] text-slate-400">
                            <Clock className="w-3 h-3 text-amber-500 animate-spin" />
                            <span>Status: Human-in-the-Loop Assessment</span>
                          </div>
                        </div>
                      )}
                    </div>
                  </div>

                </div>
              );
            })}

            {candidateApps.length === 0 && (
              <div className="text-center p-12 bg-white rounded-2xl border border-slate-200 space-y-4">
                <FileText className="h-12 w-12 mx-auto text-slate-300" />
                <p className="text-slate-500 text-sm">You haven't submitted any applications under this email yet.</p>
                <button 
                  onClick={() => onNavigate('jobs')}
                  className="bg-purple-600 text-white font-bold px-5 py-2 rounded-lg text-xs"
                >
                  Apply For Your First Role
                </button>
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  );
}

// --- RECRUITER PORTAL DASHBOARD VIEW ---
function DashboardView({ applications, jobs, onUpdate }) {
  const getJobTitle = (id) => jobs.find(j => j.id === id)?.title || 'Unknown Role';

  const getScoreColor = (score) => {
    if (score >= 80) return 'text-green-600 bg-green-50 border-green-200';
    if (score >= 50) return 'text-yellow-600 bg-yellow-50 border-yellow-200';
    return 'text-red-600 bg-red-50 border-red-200';
  };

  return (
    <div className="space-y-6 animate-[fade-in_0.4s_ease-out]">
      <div className="flex flex-col md:flex-row justify-between items-start md:items-center border-b border-purple-100 pb-6 mb-6">
        <div>
          <h1 className="text-3xl font-extrabold text-slate-900">Recruiter Command Center</h1>
          <p className="text-slate-600 mt-1">Review skills metrics &amp; adjust candidate mentoring feedback</p>
        </div>
        <div className="mt-4 md:mt-0 flex items-center space-x-2 bg-white border border-purple-100 rounded-lg p-2 shadow-sm">
          <div className="h-2 w-2 rounded-full bg-green-500 animate-pulse"></div>
          <span className="text-sm font-bold text-slate-700">AI Model Online (Version 2.5)</span>
        </div>
      </div>

      {/* Metric Cards */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div className="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
          <p className="text-sm font-bold text-slate-500 uppercase tracking-wider">Total Applications</p>
          <p className="text-4xl font-extrabold text-slate-900 mt-2">{applications.length}</p>
        </div>
        <div className="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
          <p className="text-sm font-bold text-slate-500 uppercase tracking-wider">Top Matches ({'>'}75%)</p>
          <p className="text-4xl font-bold text-purple-600 mt-2">
            {applications.filter(a => a.aiScore >= 75).length}
          </p>
        </div>
        <div className="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
          <p className="text-sm font-bold text-slate-500 uppercase tracking-wider">Overrides Active</p>
          <p className="text-4xl font-bold text-emerald-600 mt-2">
            {applications.filter(a => a.recruiterScore !== a.aiScore).length}
          </p>
        </div>
      </div>

      {/* Live Pipeline Listings */}
      <div className="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div className="px-6 py-4 border-b border-purple-100 bg-purple-50/50 flex justify-between items-center">
          <h2 className="text-lg font-bold text-purple-950">Active Applicant Pipelines</h2>
          <span className="text-xs bg-purple-100 text-purple-800 font-bold px-2.5 py-1 rounded-full">Recruiter Override Enabled</span>
        </div>
        
        <div className="divide-y divide-slate-100">
          {[...applications].sort((a, b) => b.recruiterScore - a.recruiterScore).map((app) => (
            <div key={app.id} className="p-6 hover:bg-slate-50 transition-all flex flex-col xl:flex-row gap-6">
              
              {/* Candidate Bio Block */}
              <div className="flex-1 space-y-2">
                <div className="flex flex-wrap items-center gap-3">
                  <h3 className="text-lg font-bold text-slate-900">{app.name}</h3>
                  <span className={`text-[11px] font-semibold px-2 py-0.5 rounded ${app.type === 'Internship' ? 'bg-indigo-50 text-indigo-700 border border-indigo-200' : 'bg-amber-50 text-amber-700 border border-amber-200'}`}>
                    {app.type} Track
                  </span>
                  
                  {/* Status Picker Selector */}
                  <select 
                    value={app.status} 
                    onChange={(e) => onUpdate(app.id, 'status', e.target.value)}
                    className="text-xs font-semibold bg-slate-100 border border-slate-300 rounded px-2.5 py-0.5 text-slate-600 outline-none focus:ring-1 focus:ring-purple-600"
                  >
                    <option value="AI Calibrated">AI Calibrated</option>
                    <option value="Shortlisted">Shortlisted</option>
                    <option value="Interview Scheduled">Interview Scheduled</option>
                  </select>
                </div>

                <p className="text-sm text-slate-500 flex items-center">
                  <Briefcase className="w-4 h-4 mr-1.5 text-slate-400" /> 
                  Applied for: <span className="font-semibold text-slate-700 ml-1">{getJobTitle(app.jobId)}</span>
                </p>
                <p className="text-xs text-slate-500">{app.email} • Recieved {app.date}</p>
                
                {app.portfolioUrl && (
                  <p className="text-xs text-purple-600 flex items-center gap-1">
                    <Link2 className="w-3.5 h-3.5" /> <a href={app.portfolioUrl} target="_blank" rel="noopener noreferrer" className="hover:underline truncate max-w-xs">{app.portfolioUrl}</a>
                  </p>
                )}

                {/* Overwrite slider bar */}
                <div className="pt-3 bg-slate-50/50 p-3 rounded-lg border border-slate-150 space-y-1 max-w-sm">
                  <div className="flex justify-between items-center text-xs font-semibold text-slate-700">
                    <span className="flex items-center gap-1"><UserCheck className="w-3.5 h-3.5 text-purple-600" /> Human Override Score:</span>
                    <span className="text-purple-700 text-sm font-bold">{app.recruiterScore}%</span>
                  </div>
                  <input 
                    type="range" 
                    min="0" 
                    max="100" 
                    value={app.recruiterScore} 
                    onChange={(e) => onUpdate(app.id, 'recruiterScore', parseInt(e.target.value))}
                    className="w-full accent-purple-600 cursor-pointer h-1 bg-slate-200 rounded-lg appearance-none"
                  />
                  <p className="text-[10px] text-slate-400">Tweak evaluation scores to reflect additional transferable skills.</p>
                </div>
              </div>

              {/* Match Scoring Badges */}
              <div className="shrink-0 flex gap-4">
                <div className="flex flex-col items-center justify-center w-20 h-20 rounded-xl border border-slate-100 shadow-sm bg-white">
                   <span className="text-[9px] font-bold text-slate-400 uppercase tracking-wider">AI Match</span>
                   <span className="text-lg font-bold text-slate-500">
                     {app.aiScore}%
                   </span>
                </div>
                <div className="flex flex-col items-center justify-center w-24 h-24 rounded-2xl border border-purple-200 shadow-md bg-white">
                   <span className="text-[10px] font-bold text-purple-600 uppercase tracking-wider mb-1">Recruiter</span>
                   <span className={`text-2xl font-black ${getScoreColor(app.recruiterScore).split(' ')[0]}`}>
                     {app.recruiterScore}%
                   </span>
                </div>
              </div>

              {/* AI auto assessments & Interactive Form Notes */}
              <div className="flex-1 md:max-w-md space-y-4">
                <div className="bg-slate-50 p-4 rounded-xl border border-slate-100 relative">
                  <BrainCircuit className="absolute top-4 right-4 h-5 w-5 text-slate-300" />
                  <h4 className="text-xs font-bold text-slate-500 uppercase mb-2">
                    AI Auto-Analysis
                  </h4>
                  <p className="text-xs text-slate-700 leading-relaxed">
                    {app.aiSummary}
                  </p>
                </div>

                <div className="space-y-1">
                  <label className="text-xs font-bold text-purple-700 uppercase flex items-center gap-1">
                    <MessageSquare className="w-3.5 h-3.5" /> Direct Mentor Feedback (Visible in Candidate Inbox):
                  </label>
                  <textarea
                    className="w-full p-2 text-xs border border-purple-100 rounded-lg focus:ring-1 focus:ring-purple-500 outline-none resize-none h-16 bg-white"
                    placeholder="Provide constructive, encouraging feedback or interview preparation advice..."
                    value={app.recruiterFeedback || ''}
                    onChange={(e) => onUpdate(app.id, 'recruiterFeedback', e.target.value)}
                  />
                </div>
              </div>

            </div>
          ))}
          
          {applications.length === 0 && (
             <div className="p-12 text-center text-slate-500">
               <FileText className="h-12 w-12 mx-auto text-slate-300 mb-4" />
               <p>No applications received yet.</p>
             </div>
          )}
        </div>
      </div>
    </div>
  );
}
