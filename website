        {currentView === 'home' && (
          <HomeView 
            onNavigate={navigate} 
            compassStep={compassStep}
            setCompassStep={setCompassStep}
            compassScores={compassScores}
            setCompassScores={setCompassScores}
            mascotBubble={mascotBubble}
            onMascotClick={handleMascotClick}
            candidateLoginInput={candidateLoginInput}
            setCandidateLoginInput={setCandidateLoginInput}
            onCandidateLogin={handleCandidateLogin}
            loginFeedback={loginFeedback}
            activeCandidateEmail={activeCandidateEmail}
            onLogout={handleLogoutCandidate}
          />
        )}
        {currentView === 'jobs' && <JobsView onNavigate={navigate} />}
        {currentView === 'apply' && <ApplyView job={selectedJob} onNavigate={navigate} applications={applications} setApplications={setApplications} activeCandidateEmail={activeCandidateEmail} setActiveCandidateEmail={setActiveCandidateEmail} />}
        {currentView === 'dashboard' && (
          <DashboardView 
            applications={applications} 
            jobs={JOBS} 
            onUpdate={handleRecruiterUpdate}
          />
        )}
        {currentView === 'inbox' && (
          <CandidateInboxView 
            activeCandidateEmail={activeCandidateEmail}
            candidateLoginInput={candidateLoginInput}
            setCandidateLoginInput={setCandidateLoginInput}
            onLogin={handleCandidateLogin}
            loginFeedback={loginFeedback}
            applications={applications}
            jobs={JOBS}
            onLogout={handleLogoutCandidate}
            onNavigate={navigate}
          />
        )}
      </main>

      {/* Footer */}
      <footer className="bg-slate-950 text-slate-400 py-12 mt-auto border-t border-purple-950/20">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center">
          <div className="flex items-center mb-4 md:mb-0">
            <Building2 className="h-6 w-6 text-purple-500 mr-2" />
            <span className="text-xl font-bold text-white">NexusHR</span>
          </div>
          <div className="flex space-x-6 text-sm">
            <a href="#" className="hover:text-white transition-colors">Privacy Policy</a>
            <a href="#" className="hover:text-white transition-colors">Terms of Service</a>
            <a href="#" className="hover:text-white transition-colors">AI Ethics Statement</a>
          </div>
        </div>
